[Unit]
Description=OpenClaw Startup Message Replay
# 在 openclaw-gateway 服务成功启动后执行
After=openclaw-gateway.service
Requires=openclaw-gateway.service

[Service]
Type=oneshot
# 延迟8秒让 gateway 完成 WebSocket 连接后再执行
ExecStart=/usr/bin/python3 /opt/openclaw/shared/tools/replay.py
StandardOutput=append:/tmp/openclaw-replay.log
StandardError=append:/tmp/openclaw-replay.log
# 回放失败不影响主服务
RemainAfterExit=no

[Install]
WantedBy=default.target
